
name: Build GPS TRUCK ALEX

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Download source
        uses: actions/checkout@v4

      - name: Install Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Create Android project
        run: |
          mkdir -p app/src/main/java/com/gptruckalex
          mkdir -p app/src/main/res/values

          echo 'pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
          dependencyResolutionManagement {
            repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
            repositories { google(); mavenCentral() }
          }
          rootProject.name = "GpsTruckAlex"
          include(":app")' > settings.gradle.kts

          echo 'plugins {
            id("com.android.application") version "8.7.3" apply false
            id("org.jetbrains.kotlin.android") version "2.0.21" apply false
          }' > build.gradle.kts

          echo 'plugins {
            id("com.android.application")
            id("org.jetbrains.kotlin.android")
          }
          android {
            namespace = "com.gptruckalex"
            compileSdk = 35
            defaultConfig {
              applicationId = "com.gptruckalex"
              minSdk = 24
              targetSdk = 35
              versionCode = 1
              versionName = "0.1"
            }
          }
          dependencies {
            implementation("org.osmdroid:osmdroid-android:6.1.20")
          }' > app/build.gradle.kts

          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
            <uses-permission android:name="android.permission.INTERNET"/>
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
            <application android:theme="@android:style/Theme.Material.NoActionBar"
              android:label="GPS TRUCK ALEX">
              <activity android:name=".MainActivity" android:exported="true">
                <intent-filter>
                  <action android:name="android.intent.action.MAIN"/>
                  <category android:name="android.intent.category.LAUNCHER"/>
                </intent-filter>
              </activity>
            </application>
          </manifest>
          EOF

          cat > app/src/main/java/com/gptruckalex/MainActivity.kt <<'EOF'
          package com.gptruckalex

          import android.app.Activity
          import android.os.Bundle
          import android.graphics.Color
          import android.widget.LinearLayout
          import android.widget.TextView
          import org.osmdroid.config.Configuration
          import org.osmdroid.tileprovider.tilesource.TileSourceFactory
          import org.osmdroid.util.GeoPoint
          import org.osmdroid.views.MapView

          class MainActivity : Activity() {
            override fun onCreate(savedInstanceState: Bundle?) {
              super.onCreate(savedInstanceState)
              Configuration.getInstance().userAgentValue = packageName

              val layout = LinearLayout(this)
              layout.orientation = LinearLayout.VERTICAL
              layout.setBackgroundColor(Color.rgb(16,24,32))

              val title = TextView(this)
              title.text = "GPS TRUCK ALEX"
              title.textSize = 24f
              title.setTextColor(Color.WHITE)
              title.setPadding(20,25,20,25)
              layout.addView(title)

              val profile = TextView(this)
              profile.text = "TIR: 4.00m | 2.55m | 16.50m | 40t\\nCAMION RIGID: 3.50m | 2.55m | 8m | 18t"
              profile.setTextColor(Color.WHITE)
              profile.setPadding(15,15,15,15)
              layout.addView(profile)

              val map = MapView(this)
              map.setTileSource(TileSourceFactory.MAPNIK)
              map.setMultiTouchControls(true)
              map.controller.setZoom(5.0)
              map.controller.setCenter(GeoPoint(46.2,9.2))
              layout.addView(map, LinearLayout.LayoutParams(-1,0,1f))

              setContentView(layout)
            }
          }
          EOF

      - name: Build APK
        run: |
          gradle --version
          gradle assembleDebug

      - name: Save APK
        uses: actions/upload-artifact@v4
        with:
          name: GPS-TRUCK-ALEX
          path: app/build/outputs/apk/debug/app-debug.apk
